+				} else {
+					extra = (max_width - line->size_x) /
+					    (line->n - 1);
+					width = ITEM_HSPC;
+					for (i = 0; i < line->n; i++) {
+						line->items[i]->header.pos_x =
+						    width;
+						width += ITEM_HSPC +
+						    line->items[i]
+						    ->header.size_x +
+						    extra;
+					}
+				}
+			} else {
+				extra = (max_width - line->size_x) / extra;
+				width = ITEM_HSPC;
+				for (i = 0; i < line->n; i++) {
+					line->items[i]->header.pos_x = width;
+					if (line->items[i]->type == I_INPUT)
