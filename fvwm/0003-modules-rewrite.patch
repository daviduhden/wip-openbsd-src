+			if (cur - 1 >= 0 &&
+			    compare_windows(man->sort, win,
+			    bp[cur - 1]->drawn_state.win) < 0) {
+				start = cur - 1;
+				finish = -1;
+				cmp_dir = -1;
+				correction = 1;
+			} else if (cur < num_windows - 1 &&
+			    compare_windows(man->sort, win,
+			    bp[cur + 1]->drawn_state.win) > 0) {
+				start = cur + 1;
+				finish = num_windows;
