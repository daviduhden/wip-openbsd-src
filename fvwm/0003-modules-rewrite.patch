+			ConsoleMessage("You specified a 0x0 window\n");
+			ShutMeDown(0);
+		} else {
+			man->geometry.dir |= GROW_VERT;
+		}
+		man->geometry.rows = 1;
+	} else {
+		if (man->geometry.cols == 0) {
+			man->geometry.dir |= GROW_HORIZ;
+			man->geometry.cols = 1;
+		} else {
