+
+	seg[i].x1 = x;
+	seg[i].y1 = y;
+	seg[i].x2 = x;
+	seg[i++].y2 = h + y - 1;
+
+	seg[i].x1 = x + 1;
+	seg[i].y1 = y + 1;
+	seg[i].x2 = x + w - 2;
+	seg[i++].y2 = y + 1;
+
+	seg[i].x1 = x + 1;
+	seg[i].y1 = y + 1;
+	seg[i].x2 = x + 1;
+	seg[i++].y2 = y + h - 2;
+	XDrawSegments(theDisplay, man->theWindow, rgc, seg, i);
+
+	i = 0;
+	seg[i].x1 = x;
+	seg[i].y1 = y + h - 1;
+	seg[i].x2 = w + x - 1;
+	seg[i++].y2 = y + h - 1;
+
+	seg[i].x1 = x + w - 1;
+	seg[i].y1 = y;
+	seg[i].x2 = x + w - 1;
+	seg[i++].y2 = y + h - 1;
+	XDrawSegments(theDisplay, man->theWindow, sgc, seg, i);
+
+	i = 0;
+	seg[i].x1 = x + 1;
+	seg[i].y1 = y + h - 2;
+	seg[i].x2 = x + w - 2;
+	seg[i++].y2 = y + h - 2;
+
+	seg[i].x1 = x + w - 2;
+	seg[i].y1 = y + 1;
+	seg[i].x2 = x + w - 2;
+	seg[i++].y2 = y + h - 2;
+
+	XDrawSegments(theDisplay, man->theWindow, sgc, seg, i);
+}
