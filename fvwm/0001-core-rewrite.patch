--- fvwm/fvwm/fvwm2.1
+++ fvwm/fvwm/fvwm2.1
@@ -1,2674 +1,369 @@
-.\" $OpenBSD: fvwm2.1,v 1.2 2019/10/19 16:39:49 matthieu Exp $
-.\" t
-.\" @(#)fvwm2.1 8/11/1998
-.de EX		\"Begin example
-.ne 5
-.if n .sp 1
-.if t .sp .5
-.nf
-.in +.5i
