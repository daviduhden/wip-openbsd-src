+Bool
+IsTransientDescendantOf(FvwmWindow *t, FvwmWindow *ancestor)
+{
+	FvwmWindow *p;
+	Window tw;
+
+	if (t == ancestor)
+		return False;
+	if ((t->flags & TRANSIENT) == 0)
+		return False;
+	tw = t->transientfor;
+	while (tw != None && tw != Scr.Root) {
+		if (tw == ancestor->w)
+			return True;
+		for (p = Scr.FvwmRoot.next; p != NULL; p = p->next) {
+			if (p->w == tw) {
+				if ((p->flags & TRANSIENT) == 0)
+					return False;
+				tw = p->transientfor;
+				break;
+			}
+		}
+		if (p == NULL)
+			return False;
+	}
+	return False;
+}
 
