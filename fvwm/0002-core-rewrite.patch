+			break;
+		}
+		if (waited == 0)
+			usleep(PIPE_REAP_WAIT_USEC);
+	}
+
+	if (timed_out && waited != child->pid) {
+		kill(child->pid, SIGKILL);
+		while ((waited = waitpid(child->pid, &status, 0)) == -1 &&
+		    errno == EINTR)
+			;
