#!/usr/bin/perl
#
# Author: Charles K. Hines
#
# Description:
#   A simple perl script which parses xlock's output to build an fvwm 2.xx
#   menu definition of all of xlock's modes.
#

use strict;
use warnings;

my $start = 0;

# xlock can write its help to stderr.
open my $xlock, '-|', '/bin/sh', '-c', 'exec xlock -h 2>&1'
  or die "couldn't run xlock: $!";

print "DestroyMenu XLockMenu\n";
print "AddToMenu XLockMenu \"XLock Modes\" Title\n";

while (<$xlock>) {
    chomp;

    if (/where mode is one of:/) {
        $start = 1;
        next;
    }
    if ( $start && $_ ) {
        my ( $mode, @description ) = split;
        next if defined $mode && $mode =~ /^-/;
        $mode //= '';
        printf "+ \"%-10s %-35s Exec xlock -mode %s\n", $mode,
          "(@description)\"", $mode;
    }
}

close $xlock;
