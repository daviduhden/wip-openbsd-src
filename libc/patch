+	__extension__({                                                                   \
+		__auto_type __stdc_x = (x);                                               \
+		(__typeof__(__stdc_x))(__stdc_x <= 1                                      \
+		                           ? 1                                            \
+					   : ((__typeof__(__stdc_x))2                     \
+		                                 << (stdc_bit_width((                     \
