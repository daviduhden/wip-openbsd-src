+		__stdc_n < __stdc_arg_width(x) ? __stdc_n + 1 : 0U;            \
+	})
+#define stdc_first_trailing_zero(x)                                            \
+	__extension__({                                                        \
+		unsigned int __stdc_n = stdc_trailing_ones(x);                 \
+		__stdc_n < __stdc_arg_width(x) ? __stdc_n + 1 : 0U;            \
+	})
+#define stdc_first_trailing_one(x)                                             \
+	__extension__({                                                        \
+		unsigned int __stdc_n = stdc_trailing_zeros(x);                \
+		__stdc_n < __stdc_arg_width(x) ? __stdc_n + 1 : 0U;            \
+	})
