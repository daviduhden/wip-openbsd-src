+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+/*
+ * ISO C11 <stdnoreturn.h>: the noreturn macro must expand to a function
+ * specifier so that a function declared with it is treated as not
+ * returning.  The test is primarily a compile-time one: a function marked
+ * noreturn that does not syntactically return must not trigger
+ * -Wreturn-type, and the header must be includable on its own.
+ */
+
+#include <assert.h>
+#include <stdlib.h>
+#include <stdnoreturn.h>
+
+noreturn static void
+give_up(void)
+{
+	exit(0);
+}
+
+static int
+classify(int n)
+{
+	if (n < 0)
+		give_up();
+	return n + 1;
+}
+
+int
+main(void)
+{
+	assert(classify(41) == 42);
+	return 0;
+}
